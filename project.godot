; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Digimon World GODOT"
run/main_scene="res://scenes/game.tscn"
run/main_scene.template="res://scenes/launcher/launcher.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/use_custom_user_dir=false
config/use_custom_user_dir.template=true
config/custom_user_dir_name="dw_godot4"

[autoload]

GameData="*res://scripts/data/game_data.gd"
GameState="*res://scripts/state/game_state.gd"
GameLoop="*res://scripts/core/game_loop.gd"
Sound="*res://scripts/audio/sound_system.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=1280
window/size/window_height_override=960
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dw_tools/plugin.cfg")

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

psx_ambient={
"type": "vec3",
"value": Vector3(0.5, 0.5, 0.5)
}
psx_light_0_dir={
"type": "vec3",
"value": Vector3(0, -0.984784, 0.173785)
}
psx_light_0_color={
"type": "vec3",
"value": Vector3(0.695313, 0.695313, 0.695313)
}
psx_light_1_dir={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
psx_light_1_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
psx_light_2_dir={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
psx_light_2_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
psx_ui_filter={
"type": "bool",
"value": true
}
