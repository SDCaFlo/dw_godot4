# Godot 4+ specific ignores
.godot/
/android/

# Asset porter / data porter (generated game content, never committed)
asset_porter/output/
data_porter/output/
# Editor mirror of the dw1 assets (Project > Tools > DW: Mirror dw1 assets), imported by Godot
/content/dw1/
__pycache__/

# Issue evidence: screenshots of the game (game art, never committed); see ISSUES.md
/issues/evidence/

# dw_convert build (PyInstaller environment, work files, the built exe)
/dw_convert/.build/
/dw_convert/dist/

# Godot export (export_presets.cfg "Windows Desktop": the exe and its .pck)
/build/*
!/build/.gdignore

# CI: Godot and its export template downloaded by .github/workflows/release.yml
/.ci/
